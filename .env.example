# ============================================================
# Contoh konfigurasi - salin file ini menjadi .env
# ============================================================
# Perintah (PowerShell):  Copy-Item .env.example .env
# Perintah (bash)      :  cp .env.example .env
#
# Ambil nilainya dari Supabase Dashboard > Project Settings > API:
# - SUPABASE_URL       = Project URL
# - SUPABASE_ANON_KEY  = anon / publishable key
#
# DILARANG memakai service_role key di aplikasi.

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>

# Dipakai sebagai user_id selama belum ada fitur login.
DEMO_USER_ID=11111111-1111-4111-8111-111111111111
