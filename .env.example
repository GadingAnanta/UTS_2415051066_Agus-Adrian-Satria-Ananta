# ============================================================
# Contoh konfigurasi - salin file ini menjadi .env
# ============================================================
# Perintah (PowerShell):  Copy-Item .env.example .env
# Perintah (bash)      :  cp .env.example .env
#
# Ambil nilainya dari Supabase Dashboard > Project Settings > API:
# - SUPABASE_URL       = Project URL
# - SUPABASE_ANON_KEY  = anon / publishable key
#
# DILARANG memakai service_role key di aplikasi.

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>

# Dipakai sebagai user_id selama belum ada fitur login.
DEMO_USER_ID=11111111-1111-4111-8111-111111111111

# Alamat REST API untuk halaman Katalog & Tips (HTTP GET, berkas JSON).
# Dua pilihan yang sama-sama valid:
#   1. GitHub Pages : https://<username>.github.io/<repo>/api/tips.json
#   2. Berkas mentah: https://raw.githubusercontent.com/<username>/<repo>/main/api/tips.json
# Kalau dikosongkan, aplikasi memakai alamat bawaan di TipsRepository.urlBawaan.
TIPS_API_URL=https://<username>.github.io/<repo>/api/tips.json
